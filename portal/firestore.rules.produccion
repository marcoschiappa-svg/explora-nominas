rules_version = '2';

// =============================================================================
// REGLAS DE FIRESTORE — PRODUCCION (proyecto: explora-portal)
//
// Este archivo es la FUENTE DE VERDAD de las reglas de la base real.
// Se versiona en el repo y se publica desde acá. No se edita en la consola
// web: si alguien la edita ahí, el repo queda desactualizado en silencio.
//
// COMO PUBLICAR
//   cd portal
//   firebase use              -> tiene que decir: explora-portal
//   firebase deploy --only firestore:rules
//
// ANTES DE PUBLICAR, COMPROBAR QUE:
//   1. `firebase use` devuelve explora-portal (no otro proyecto).
//   2. Ninguna regla permite acceso sin condicion. Verificar con:
//        findstr /C:"if true" firestore.rules.produccion | findstr /V /C:"//"
//      Tiene que devolver VACIO. Si devuelve algo, PARAR: hay una regla
//      que abre la base entera.
//
// El archivo firestore.rules.emulador queda en el repo solo como referencia
// historica de las reglas permisivas. El emulador usa ESTE archivo, igual que
// produccion, para que lo que se prueba local sea lo que corre en la realidad.
//
// Ultima modificacion: agosto 2026 — se versiona en el repo y se pasa a
// publicar por firebase deploy (antes se editaba en la consola web).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles de usuario. Lectura para cualquier autenticado (la app necesita
    // resolver el perfil del chofer al iniciar sesion); escritura solo admin.
    match /usuarios_portal/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios_portal/$(request.auth.uid)).data.rol == 'admin';
    }

    // Pedidos y despachos. Es la coleccion que usan tanto el portal como la app
    // de choferes para el ciclo de vida completo del viaje.
    //
    // PENDIENTE DE REVISION: hoy cualquier usuario autenticado puede leer y
    // escribir CUALQUIER pedido. Un chofer puede ver los datos de todos los
    // clientes y modificar despachos que no le corresponden. No es la causa de
    // ningun defecto actual, pero conviene restringirlo por rol y por DNI antes
    // de salir a produccion abierta.
    match /pedidos_portal/{pedidoId} {
      allow read, write: if request.auth != null;
    }

    // Empresas de transporte. Escritura solo admin.
    match /transportistas_portal/{transportistaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios_portal/$(request.auth.uid)).data.rol == 'admin';
    }

    // Configuracion general del portal.
    match /portal/{docId} {
      allow read, write: if request.auth != null;
    }

    // Versiones del convenio CATAC. Escritura solo admin.
    match /catac_versiones/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios_portal/$(request.auth.uid)).data.rol == 'admin';
    }

    // Versiones del tarifario. Escritura solo admin.
    match /tarifario_versiones/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios_portal/$(request.auth.uid)).data.rol == 'admin';
    }

    // -------------------------------------------------------------------------
    // NUEVO (agosto 2026) — Log remoto de la app TrackEx
    //
    // La app escribe aca eventos de diagnostico: permisos concedidos o
    // denegados, arranque del servicio de GPS, errores de escritura con su
    // codigo. Sin esto, diagnosticar una falla en produccion exige tener el
    // telefono del chofer en la mano.
    //
    // Solo se permite CREAR. Nadie puede leer, modificar ni borrar desde la app:
    // los logs se consultan desde la consola de Firebase.
    // -------------------------------------------------------------------------
    match /app_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

  }
}
