{
  "expo": {
    "experiments": {
      "onDemandFilesystem": false
    },
    "name": "TrackEx",
    "slug": "explora-app-54",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "explora-sa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.explora.trackex",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TrackEx necesita tu ubicación para el seguimiento de viajes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TrackEx necesita tu ubicación en segundo plano para registrar el recorrido activo.",
        "NSFaceIDUsageDescription": "Usamos Face ID para que puedas ingresar de forma rápida y segura."
      }
    },
    "android": {
      "package": "com.explora.trackex",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#C9173A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TrackEx necesita tu ubicación en segundo plano para registrar el recorrido activo.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9173A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C9173A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9e00dba-515c-4683-b3ba-d708a3d43d94"
      }
    }
  }
}
